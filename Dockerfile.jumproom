# Build stage: runs natively on the host CPU (no QEMU) to avoid esbuild/Go lfstack crashes.
# Only compiles TypeScript/bundles JS here — no native modules are loaded, so the
# alpine (musl) build output for backend/dist and admin/dist is portable to the
# glibc runtime image below. better-sqlite3's native addon is built separately,
# directly in the runtime stage, so it matches that stage's glibc/ABI.
FROM --platform=$BUILDPLATFORM node:20-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json* ./
COPY backend/package.json ./backend/
COPY admin/package.json ./admin/
RUN npm install
COPY tsconfig.base.json ./
COPY backend/tsconfig.json ./backend/
COPY backend/src ./backend/src
COPY admin ./admin
COPY overlay ./overlay
RUN npm run build -w backend
RUN npm run build -w admin

# Runtime stage: amd64 container for noVNC deployment
FROM jlesage/baseimage-gui:ubuntu-20.04-v4

ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

WORKDIR /app

# Set application metadata via baseimage helper
RUN set-cont-env APP_NAME "Alert Hub" && \
    set-cont-env APP_VERSION "0.1.0"

# Install Chrome dependencies
RUN add-pkg \
    ca-certificates \
    libnss3 \
    gconf-service \
    libc6 \
    libcairo2 \
    libexpat1 \
    libfontconfig1 \
    libgcc1 \
    libgconf-2-4 \
    libgdk-pixbuf2.0-0 \
    libglib2.0.0 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libstdc++6 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcursor1 \
    libxext6 \
    libxi6 \
    libxrender1 \
    libxtst6 \
    libappindicator1 \
    gnupg2 \
    pulseaudio-utils \
    curl \
    wget \
    socat \
    alsa-base \
    alsa-utils \
    fonts-liberation \
    fonts-noto-color-emoji \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libwayland-client0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    x11-xserver-utils \
    xdg-utils \
    libu2f-udev \
    libvulkan1 \
    libsndfile1-dev \
    libxss1 \
    dbus \
    dbus-x11 \
    upower \
    git \
    python3 \
    make \
    g++

### Support NVIDIA GPUs for graphics acceleration
RUN echo "/usr/local/nvidia/lib" >> /etc/ld.so.conf.d/nvidia.conf && \
    echo "/usr/local/nvidia/lib64" >> /etc/ld.so.conf.d/nvidia.conf

### Install Google Chrome
RUN curl -sSL https://dl.google.com/linux/linux_signing_key.pub | apt-key add - && \
    echo "deb [arch=amd64] https://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list && \
    add-pkg google-chrome-stable
RUN sed -i '/^SystemdService=/d' /usr/share/dbus-1/system-services/org.freedesktop.UPower.service && \
    dbus-uuidgen > /etc/machine-id

### Install Node.js 20 to run the backend at runtime
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    add-pkg nodejs

### Install the backend's production dependencies here (not in the alpine build
### stage above) so native addons — better-sqlite3 — compile against this image's
### own glibc/ABI instead of alpine's musl.
COPY package.json package-lock.json* ./
COPY backend/package.json ./backend/
COPY admin/package.json ./admin/
RUN npm ci -w backend --omit=dev

### Copy pre-built backend + admin SPA from the build stage (avoids running esbuild
### or tsc under QEMU), plus the overlay page the backend serves at /overlay.
COPY --from=builder /app/backend/dist ./backend/dist
COPY --from=builder /app/admin/dist ./admin/dist
COPY overlay ./overlay

### Default env so the backend (env.ts) will actually boot without a real .env —
### fine for visually reviewing the admin UI/overlay. Non-secret values only;
### TWITCH_CLIENT_SECRET/OVERLAY_TOKEN/SESSION_SECRET/ADMIN_PASSWORD are
### generated at container startup instead (see startapp.sh) so nothing
### secret-shaped is baked into the image layers. DATABASE_PATH lands in
### /config, the baseimage's persistent data dir, so the SQLite file (and the
### generated secrets, see startapp.sh) survive container restarts.
ENV PORT=3000
ENV DATABASE_PATH=/config/alertbox.db
ENV NODE_ENV=production
ENV LOG_LEVEL=info
ENV TWITCH_CLIENT_ID=jumproom-placeholder-client-id
ENV TWITCH_REDIRECT_URI=http://localhost:3000/auth/callback

### Copy container filesystem overlays (noVNC UI, NVIDIA config, PulseAudio config)
COPY rootfs/ /

ADD startapp.sh /startapp.sh
RUN chmod +x /startapp.sh
